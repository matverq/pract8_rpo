<Page x:Class="pract8_RPO.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8_RPO"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListView Grid.Row="1" ItemsSource="{Binding Source={x:Static local:DataStore.Cart}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Product.Name}" Width="200"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Product.Price}" Width="100"/>
                    <GridViewColumn Header="Кол-во" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalSum}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Промокод:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TxtPromo" Width="100" TextChanged="TxtPromo_TextChanged"/>
            </StackPanel>


            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Итого: " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalAmountText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,10,0"/>
                <Button Content="Оформить заказ" Click="Checkout_Click"/>
                <Button Content="Продолжить покупки" Background="LightGray" Foreground="Black" Click="Continue_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
