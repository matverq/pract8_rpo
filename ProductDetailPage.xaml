<Page x:Class="pract8_RPO.ProductDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8_RPO"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductDetailPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray" Height="150" Width="150" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,0">
            <TextBlock x:Name="TxtName" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TxtPrice" FontSize="18" Foreground="DarkGreen" Margin="0,10"/>
            <TextBlock x:Name="TxtDesc" TextWrapping="Wrap" Margin="0,10"/>
            <Button Content="Добавить в корзину" HorizontalAlignment="Left" Click="AddToCart_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
            <TextBlock Text="Характеристики:" FontWeight="Bold" Margin="0,0,0,5"/>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="5">
                <TextBlock x:Name="TxtCategory"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>