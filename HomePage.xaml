<Page x:Class="pract8_RPO.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8_RPO"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <StackPanel Margin="20">
        <TextBlock Text="Добро пожаловать в мир Электроники!" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Лучшие гаджеты по лучшим ценам." FontSize="14" Margin="0,10,0,20"/>

        <Button Content="Перейти в каталог" HorizontalAlignment="Left" Click="GoToCatalog_Click"/>

        <TextBlock Text="Поиск по сайту:" Margin="0,20,0,5"/>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="TxtSearchHome" Width="200"/>
            <Button Content="Найти" Click="Search_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
